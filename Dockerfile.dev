# Frontend Development Dockerfile
FROM node:20-alpine AS dev

WORKDIR /app

RUN apk add --no-cache libc6-compat curl

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_PUBLIC_API_URL=http://localhost:9000

EXPOSE 3000

CMD ["npm", "run", "dev"]
